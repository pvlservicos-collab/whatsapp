# =============================================
# BANCO DE DADOS - Neon (Vercel Integration)
# =============================================
# Obtenha em: vercel.com → Storage → Create Database → Neon
# Ou no painel Neon: console.neon.tech → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# =============================================
# AUTENTICAÇÃO - NextAuth v5
# =============================================
# Gere com: openssl rand -base64 32
AUTH_SECRET=sua_string_secreta_de_32_chars_aqui

# URL do app (em dev: http://localhost:3000)
NEXTAUTH_URL=https://seu-dominio.vercel.app

# =============================================
# ARMAZENAMENTO - Vercel Blob
# =============================================
# Gerado automaticamente pelo Vercel ao criar o Blob Store
# Em dev: instale Vercel CLI → vercel env pull
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxx

# =============================================
# REALTIME - Pusher (substitui Supabase Realtime)
# =============================================
# Crie grátis em: pusher.com → Create App
PUSHER_APP_ID=seu_app_id
PUSHER_KEY=sua_key
PUSHER_SECRET=seu_secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=sua_key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# =============================================
# INTEGRAÇÕES EXTERNAS (mantidas do projeto original)
# =============================================
UAZAPI_SERVER_URL=https://sua-instancia.uazapi.com
UAZAPI_ADMIN_TOKEN=seu_token_uazapi

# Facebook/WhatsApp Cloud API
FACEBOOK_WEBHOOK_VERIFY_TOKEN=uma_string_secreta_que_voce_escolhe

# App Secret do app do Facebook (Meta for Developers → Configurações do app → Básico)
# Usado para validar a assinatura X-Hub-Signature-256 das requisições recebidas em /api/webhooks/facebook.
# Sem essa variável, o webhook rejeita TODAS as requisições (retorna 403).
FACEBOOK_APP_SECRET=app_secret_do_facebook_developers
